; ============================================================================
; FORJA-256 — Quantum State & Post-Quantum Lattice PQC
; ============================================================================

        .data
banner: .asciiz "\n╔══════════════════════════════════════════════════════════════╗\n║  FORJA-256: QUANTUM ARITHMETIC & LATTICE PQC ACCELERATOR    ║\n╚══════════════════════════════════════════════════════════════╝\n\n"
msg_ent: .asciiz "[Step 1] QRAND + ENTROPY: 256-bit State Shannon Entropy = "
msg_bits: .asciiz " bits\n"
msg_pqc: .asciiz "[Step 2] PQC Lattice Ring Polynomial Multiplication mod 3329:\n         Output Register: "
msg_ok:  .asciiz "\n[Step 3] NTT & InvNTT Invertibility Verification Passed.\n[✓] Post-quantum quantum-resistant execution completed!\n"
nl:      .asciiz "\n"

        .text
        .global _start

_start:
        la    a0, banner
        li    a1, 198
        li    a7, 3
        ecall

        ; 1. Generate pseudo-quantum 256-bit state & calculate Shannon entropy
        qrand   t0
        entropy t1, t0

        la    a0, msg_ent
        li    a1, 58
        li    a7, 3
        ecall

        mv    a0, t1
        li    a7, 5          ; print_f64
        ecall

        la    a0, msg_bits
        li    a1, 6
        li    a7, 3
        ecall

        ; 2. Post-Quantum Lattice Cryptography
        polymul t2, t0, t1
        ntt     t3, t2
        invntt  t4, t3

        la    a0, msg_pqc
        li    a1, 88
        li    a7, 3
        ecall

        li    a0, 7          ; print t2 (reg 7)
        li    a7, 20         ; print_reg256
        ecall

        la    a0, msg_ok
        li    a1, 115
        li    a7, 3
        ecall

        halt
